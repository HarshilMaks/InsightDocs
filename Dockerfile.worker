# Full document-processing image for the dedicated Celery worker.
# Do not use this Dockerfile for the 512MB FastAPI web service.
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install --no-cache -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

# Native runtimes required by PDF/OCR/office document ingestion.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    tesseract-ocr \
    libreoffice-nogui \
    imagemagick \
    && (sed -i 's/domain="coder" rights="none" pattern="PDF"/domain="coder" rights="read|write" pattern="PDF"/g' /etc/ImageMagick-6/policy.xml || true) \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=builder /opt/venv /opt/venv
COPY backend ./backend
COPY alembic ./alembic
COPY alembic.ini .
COPY scripts ./scripts

ENV PYTHONPATH=/app
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

RUN chmod +x scripts/*.sh \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

# A worker does not listen on an HTTP port.
CMD ["bash", "scripts/start_worker.sh"]
