# Local Docker Compose Celery worker only.
# Production uses the GitHub Actions worker; do not configure this image as the
# Render web service, which must remain the lightweight API Dockerfile.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libgomp1 \
    tesseract-ocr \
    libreoffice-nogui \
    imagemagick \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Permit PDF read/write for the development converter where the distribution
# ships ImageMagick's restrictive PDF policy. Absence of this file is harmless.
RUN sed -i 's/domain="coder" rights="none" pattern="PDF"/domain="coder" rights="read|write" pattern="PDF"/g' /etc/ImageMagick-6/policy.xml || true

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY requirements.txt .

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install --no-cache -r requirements.txt

COPY backend ./backend
COPY alembic ./alembic
COPY alembic.ini .
COPY scripts ./scripts

ENV PYTHONPATH=/app
RUN chmod +x scripts/*.sh \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

CMD ["bash", "scripts/start_worker.sh"]
