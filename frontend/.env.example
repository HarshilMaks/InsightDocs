# Full FastAPI base URL, including /api/v1. Set this in Vercel and copy to
# .env.local for local frontend development against a remote API.
VITE_API_BASE_URL=https://insightdocs-api-vlbl.onrender.com/api/v1

# Legacy origin-only alternative, supported for existing deployments. Do not
# set both variables; VITE_API_BASE_URL takes precedence.
# VITE_API_URL=https://insightdocs-api-vlbl.onrender.com
