# =============================================================================
# InsightDocs — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before deploying.
# All variables marked (required) must be set; others have sensible defaults.
# =============================================================================

# --- Application ---
APP_NAME=InsightDocs
APP_ENV=production                    # "production" enables JSON logging; "development" uses plain text
APP_PORT=8000
API_PREFIX=/api/v1
DEBUG=false                           # NEVER true in production
LOG_LEVEL=INFO

# --- Security (required) ---
SECRET_KEY=                           # (required) Long random string, min 32 chars. Used for JWT + BYOK encryption.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# One Render variable can contain every allowed browser origin, comma-separated.
# Do not include path segments; trailing slashes are normalized by the API.
ALLOWED_ORIGINS=https://insightdocs.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# --- Database (required) ---
DATABASE_URL=                         # (required) e.g. postgresql://user:pass@host:5432/insightdocs

# Database connection pool
DB_POOL_SIZE=5                        # Tune based on your Postgres plan's max_connections / number of replicas
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# --- Redis (required) ---
REDIS_URL=                            # (required) e.g. redis://default:password@host:6379/0

# --- Celery (required) ---
CELERY_BROKER_URL=                    # (required) Same as REDIS_URL typically
CELERY_RESULT_BACKEND=                # (required) e.g. redis://default:password@host:6379/1

# --- LLM ---
GEMINI_API_KEY=                       # Optional system-level key. Users can provide their own via BYOK.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro
GEMINI_TEMPERATURE=0.7

# --- Vector Database (required) ---
MILVUS_URI=                           # (required) e.g. https://your-cluster.zillizcloud.com
MILVUS_TOKEN=                         # (required) Milvus/Zilliz API token
MILVUS_COLLECTION=insightdocscollection
MILVUS_DIM=768

# --- Embeddings ---
VECTOR_DIMENSION=384
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
LEGACY_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Object Storage (required) ---
S3_ENDPOINT=                          # (required) e.g. https://s3.amazonaws.com or your MinIO/Cloudflare R2 endpoint
AWS_ACCESS_KEY_ID=                    # (required)
AWS_SECRET_ACCESS_KEY=                # (required)
S3_BUCKET_NAME=insightdocs            # (required)
AWS_DEFAULT_REGION=us-east-1
